{
  "name": "placeholder",
  "version": "1.0.0",
  "main": "dist/app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env dist/app.js",
    "dev": "tsx --watch --env-file-if-exists=.env src/app.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "lint": "eslint src/**/*.ts",
    "test": "vitest --coverage --reporter=default --reporter=html",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "winston": "^3.19.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "commitlint": "^20.5.3",
    "eslint": "^10.2.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix",
      "vitest --changed"
    ]
  }
}